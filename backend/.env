NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres.xsbtrzjsdvbwoyxeehxr:rB%3Fg4.GUMbMw3hN@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=edu_sphare_session
SESSION_TTL_HOURS=12
REMEMBER_SESSION_TTL_HOURS=720

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
PASSWORD_PEPPER=replace-with-a-unique-secret-in-your-secret-manager

# CSRF (generate a strong random secret — same command as above)
# Leave blank in development to auto-generate ephemerally
CSRF_SECRET=

# Rate limiting (defaults shown — adjust per environment)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_GLOBAL_WINDOW_MS=60000

# Login brute-force lockout
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
