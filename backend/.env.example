NODE_ENV=development
PORT=4000

# PostgreSQL Connection String (Supabase / Neon / AWS RDS)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Frontend URL(s) for CORS & Secure Cookies (Comma separated for multiple)
WEB_ORIGIN=http://localhost:3000,https://edu-sphare.vercel.app

# JWT Configuration
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m

# Refresh Token Expiry
REFRESH_TOKEN_EXPIRES_IN=7d

# Cookie Security (lax, strict, none)
COOKIE_SAME_SITE=lax

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=60000
