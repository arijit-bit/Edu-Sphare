NODE_ENV=development
PORT=4000

# Supabase pooler URL (Transaction mode, port 6543)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.[project-ref]:[your-password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Comma-separated allowed CORS origins. Add all frontends that need access.
# Example: http://localhost:3000,https://your-app.vercel.app
WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=edu_sphare_session
SESSION_TTL_HOURS=12
REMEMBER_SESSION_TTL_HOURS=720

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
PASSWORD_PEPPER=replace-with-a-unique-secret-in-your-secret-manager

# CSRF secret — required in production, optional in dev (auto-generated if blank)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=

# Rate limiting — requests per time window per IP
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_GLOBAL_WINDOW_MS=60000

# Brute-force login protection
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
